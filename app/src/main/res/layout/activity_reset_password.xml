<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResetPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Your Password"
            android:textSize="26sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/resetInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the code we emailed you and choose a new password."
            android:textAlignment="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Code *"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/resetCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6-digit code"
            android:inputType="number"
            android:maxLength="10"
            android:background="@drawable/bg_input_field"
            android:padding="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password *"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/newPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="New password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:padding="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="At least 8 characters, with an uppercase letter, a lowercase letter, a number and a special character."
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm New Password *"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/confirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm new password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input_field"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update Password"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"/>

        <Button
            android:id="@+id/btnResendCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Resend Code"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline"
            android:textColor="@color/primary"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Back to Login"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline"
            android:textColor="@color/primary"
            android:backgroundTint="@null"/>

    </LinearLayout>
</ScrollView>