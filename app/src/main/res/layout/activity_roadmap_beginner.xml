<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F0FA"
    android:fillViewport="true"
    tools:context=".RoadmapBeginner">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />


        <!-- ===== Header ===== -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/roadmap_header"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beginner Backend Developer Roadmap"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Step by step. Learn. Build. Grow."
                android:textColor="#C9C6F2"
                android:textSize="13sp" />
        </LinearLayout>



        <!-- Back to Dashboard -->
        <TextView
            android:id="@+id/btn_back_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Back to Dashboard"
            android:textColor="#6C5CE7"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_header" />

        <!-- ===== START pill ===== -->
        <TextView
            android:id="@+id/badge_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/roadmap_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_header" />

        <!-- ===== Timeline "road" ===== -->

        <!-- ===== Step 01 ===== -->
        <View
            android:id="@+id/timeline_line"
            android:layout_width="45dp"
            android:layout_height="0dp"
            android:background="@drawable/winding_road"
            app:layout_constraintBottom_toTopOf="@id/badge_keepgoing"
            app:layout_constraintEnd_toEndOf="@id/guide_center"
            app:layout_constraintHorizontal_bias="0.111"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintTop_toBottomOf="@id/badge_start"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/badge_01"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="01"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/badge_start"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_01"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_01"
            app:layout_constraintBottom_toBottomOf="@id/badge_01"
            app:layout_constraintEnd_toStartOf="@id/badge_01" />

        <LinearLayout
            android:id="@+id/card_01"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_01"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🌐"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Understand the Basics"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="How the internet works\nWhat is a server?\nWhat is HTTP/HTTPS?\nLearn about clients, servers and APIs"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 02 ===== -->
        <TextView
            android:id="@+id/badge_02"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="02"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_01"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_02"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_02"
            app:layout_constraintBottom_toBottomOf="@id/badge_02"
            app:layout_constraintStart_toEndOf="@id/badge_02" />

        <LinearLayout
            android:id="@+id/card_02"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_02"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:contentDescription="Architecture step"
                    android:gravity="center"
                    android:text="&lt;/&gt;"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Learn a Programming Language"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Choose one (Java, Python, C#, Go, PHP, JavaScript - Node.js, Rust)\nLearn the syntax and fundamentals\nSolve small coding problems"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 03 ===== -->
        <TextView
            android:id="@+id/badge_03"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="03"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_02"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_03"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_03"
            app:layout_constraintBottom_toBottomOf="@id/badge_03"
            app:layout_constraintEnd_toStartOf="@id/badge_03" />

        <LinearLayout
            android:id="@+id/card_03"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_03"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="📊"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Learn Data Structures and Algorithms"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Variables, loops, functions\nArrays, lists, maps, sets\nBasic algorithms and problem solving"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 04 ===== -->
        <TextView
            android:id="@+id/badge_04"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="04"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_03"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_04"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_04"
            app:layout_constraintBottom_toBottomOf="@id/badge_04"
            app:layout_constraintStart_toEndOf="@id/badge_04" />

        <LinearLayout
            android:id="@+id/card_04"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_04"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🗄️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Work with Databases"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Learn SQL (e.g. MySQL, PostgreSQL)\nUnderstand database design\nPractice CRUD operations\nLearn about NoSQL (e.g. MongoDB)"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 05 ===== -->
        <TextView
            android:id="@+id/badge_05"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="05"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_04"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_05"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_05"
            app:layout_constraintBottom_toBottomOf="@id/badge_05"
            app:layout_constraintEnd_toStartOf="@id/badge_05" />

        <LinearLayout
            android:id="@+id/card_05"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Learn Backend Frameworks"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Choose a framework (e.g. Spring Boot, Express.js, Django, ASP.NET Core)\nBuild RESTful APIs\nHandle requests, responses and routing"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 06 ===== -->
        <TextView
            android:id="@+id/badge_06"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="06"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_05"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_06"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_06"
            app:layout_constraintBottom_toBottomOf="@id/badge_06"
            app:layout_constraintStart_toEndOf="@id/badge_06" />

        <LinearLayout
            android:id="@+id/card_06"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_06"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🖥️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Learn Core Backend Concepts"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="API design (REST principles)\nAuthentication &amp; authorization\nMiddleware\nError handling &amp; logging\nFile handling\nEnvironment variables"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 07 ===== -->
        <TextView
            android:id="@+id/badge_07"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="07"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_06"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_07"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_07"
            app:layout_constraintBottom_toBottomOf="@id/badge_07"
            app:layout_constraintEnd_toStartOf="@id/badge_07" />

        <LinearLayout
            android:id="@+id/card_07"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_07"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🔀"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Version Control and Collaboration"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Learn Git and GitHub\nPractice branching, commits and pull requests\nWork on real or open-source projects"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 08 ===== -->
        <TextView
            android:id="@+id/badge_08"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="08"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_07"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_08"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_08"
            app:layout_constraintBottom_toBottomOf="@id/badge_08"
            app:layout_constraintStart_toEndOf="@id/badge_08" />

        <LinearLayout
            android:id="@+id/card_08"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_08"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="☁️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Deploy and DevOps Basics"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Deploy your API (e.g. Render, Railway, Vercel, AWS)\nLearn about servers and hosting\nUnderstand CI/CD basics\nManage environment variables"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Step 09 ===== -->
        <TextView
            android:id="@+id/badge_09"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="09"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_08"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_09"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_09"
            app:layout_constraintBottom_toBottomOf="@id/badge_09"
            app:layout_constraintEnd_toStartOf="@id/badge_09" />

        <LinearLayout
            android:id="@+id/card_09"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_09"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🏆"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Build Real Projects"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Create and complete personal projects\nBuild a portfolio (e.g. GitHub)\nExplore advanced topics (scaling, microservices, message queues)\nKeep learning and improving"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ===== Footer note ===== -->
        <LinearLayout
            android:id="@+id/card_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_09">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/step_circle"
                android:backgroundTint="#E4E0FA"
                android:gravity="center"
                android:text="📈"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Consistent progress today, bigger opportunities tomorrow."
                android:textColor="#161638"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== KEEP GOING pill ===== -->
        <TextView
            android:id="@+id/badge_keepgoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/roadmap_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="KEEP GOING"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_footer"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
