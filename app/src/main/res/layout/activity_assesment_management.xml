<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IntelliPath"
                android:textColor="#151C52"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Log Out"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#151C52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="19sp" />

        </LinearLayout>


        <!-- PAGE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Assessments &amp; Roadmaps"
            android:textColor="#17172F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage assessments and student learning pathways."
            android:textColor="#77778A"
            android:textSize="11sp" />


        <!-- SEARCH + CREATE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="Search assessments/roadmaps..."
                android:textSize="10sp"
                android:padding="10dp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:layout_width="85dp"
                android:layout_height="42dp"
                android:text="+ Create"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:backgroundTint="#151C52" />

        </LinearLayout>

        <!-- NEW ASSESSMENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#F1F1F5">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#77778A"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Assessment"
                android:textColor="#55556A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start from scratch or use a template"
                android:textColor="#888899"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- ASSESSMENT 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● Active"
                    android:textColor="#6C5CE7"
                    android:textSize="8sp"
                    android:background="#EEEAFB" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textColor="#55556A"
                    android:textSize="20sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Debugging &amp; Troubleshooting"
                android:textColor="#17172F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Systematic Bug Identification &amp; Root Cause Analysis"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUESTIONS&#10;35"
                    android:textColor="#55556A"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LEVEL&#10;Advanced"
                    android:textColor="#55556A"
                    android:textSize="8sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ASSESSMENT 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● Draft"
                    android:textColor="#77778A"
                    android:textSize="8sp"
                    android:background="#EEEEF3" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textColor="#55556A"
                    android:textSize="20sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Relational Database Design"
                android:textColor="#17172F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SQL Optimisation &amp; Normalization Strategies"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUESTIONS&#10;25"
                    android:textColor="#55556A"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LEVEL&#10;Intermediate"
                    android:textColor="#55556A"
                    android:textSize="8sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ROADMAPS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Roadmaps"
            android:textColor="#17172F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage the learning paths assigned based on assessment results."
            android:textColor="#77778A"
            android:textSize="9sp" />

        <!-- NEW ROADMAP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#F1F1F5">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#77778A"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Roadmap"
                android:textColor="#55556A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new learning pathway"
                android:textColor="#888899"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- BEGINNER ROADMAP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● Active"
                    android:textColor="#6C5CE7"
                    android:textSize="8sp"
                    android:background="#EEEAFB" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#55556A"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Beginner Roadmap"
                android:textColor="#17172F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Foundation Backend Developer"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="6 MODULES     4 LABS       LEVEL: Beginner     0–49%"
                android:textColor="#55556A"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- INTERMEDIATE ROADMAP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● Active"
                    android:textColor="#6C5CE7"
                    android:textSize="8sp"
                    android:background="#EEEAFB" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#55556A"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Intermediate Roadmap"
                android:textColor="#17172F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Backend Developer"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="8 MODULES     5 LABS       LEVEL: Intermediate     50–74%"
                android:textColor="#55556A"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- ADVANCED ROADMAP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="● Active"
                    android:textColor="#6C5CE7"
                    android:textSize="8sp"
                    android:background="#EEEAFB" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#55556A"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Advanced Roadmap"
                android:textColor="#17172F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Advanced Backend Developer"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="10 MODULES     6 LABS       LEVEL: Advanced     75–100%"
                android:textColor="#55556A"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- BOTTOM NAVIGATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nDashboard"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navStudents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙\nStudents"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navAssessments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="□\nAssessments"
                android:textColor="#6C5CE7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▤\nReports"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙\nSettings"
                android:textColor="#77778A"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>