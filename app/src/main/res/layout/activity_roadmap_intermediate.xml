<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F0FA"
    android:fillViewport="true"
    tools:context=".RoadmapIntermediate">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- ===== CENTER GUIDE ===== -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/roadmap_header"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intermediate Backend Developer Roadmap"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Apply what you know. Build. Improve. Grow."
                android:textColor="#C9C6F2"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Back to Dashboard -->
        <TextView
            android:id="@+id/btn_back_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:text="Back to Dashboard"
            android:textColor="#6C5CE7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_header" />

        <!-- ===== START PILL ===== -->
        <TextView
            android:id="@+id/badge_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/roadmap_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_header" />

        <!-- ===== TIMELINE ROAD ===== -->
        <View
            android:id="@+id/timeline_line"
            android:layout_width="45dp"
            android:layout_height="0dp"
            android:background="@drawable/winding_road"
            app:layout_constraintTop_toBottomOf="@id/badge_start"
            app:layout_constraintBottom_toTopOf="@id/badge_almost"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <!-- ====================================================== -->
        <!-- STEP 01 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_01"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="01"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/badge_start"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_01"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_01"
            app:layout_constraintBottom_toBottomOf="@id/badge_01"
            app:layout_constraintEnd_toStartOf="@id/badge_01" />

        <LinearLayout
            android:id="@+id/card_01"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_01"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="💻"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Strengthen Programming &amp; Problem Solving"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Object-oriented programming&#10;Clean and reusable code&#10;Algorithms and data structures&#10;Solve more complex coding problems"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 02 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_02"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="02"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_01"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_02"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_02"
            app:layout_constraintBottom_toBottomOf="@id/badge_02"
            app:layout_constraintStart_toEndOf="@id/badge_02" />

        <LinearLayout
            android:id="@+id/card_02"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_02"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text=""
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Advanced Database Development"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Complex SQL queries and joins&#10;Relationships and database design&#10;Indexing and query optimisation&#10;Transactions"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 03 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_03"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="03"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_02"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_03"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_03"
            app:layout_constraintBottom_toBottomOf="@id/badge_03"
            app:layout_constraintEnd_toStartOf="@id/badge_03" />

        <LinearLayout
            android:id="@+id/card_03"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_03"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🔗"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Backend Application Development"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Build REST APIs&#10;Use a backend framework&#10;Connect applications to databases&#10;Implement authentication"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 04 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_04"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="04"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_03"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_04"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_04"
            app:layout_constraintBottom_toBottomOf="@id/badge_04"
            app:layout_constraintStart_toEndOf="@id/badge_04" />

        <LinearLayout
            android:id="@+id/card_04"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_04"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🧪"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Testing &amp; Debugging"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Unit testing&#10;Integration testing&#10;Debug application errors&#10;Handle edge cases and improve reliability"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 05 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_05"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="05"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_04"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_05"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_05"
            app:layout_constraintBottom_toBottomOf="@id/badge_05"
            app:layout_constraintEnd_toStartOf="@id/badge_05" />

        <LinearLayout
            android:id="@+id/card_05"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Security &amp; Performance"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Secure APIs&#10;Input validation&#10;Authentication and authorisation&#10;Identify and improve performance problems"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 06 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_06"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="06"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_05"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_06"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginStart="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_06"
            app:layout_constraintBottom_toBottomOf="@id/badge_06"
            app:layout_constraintStart_toEndOf="@id/badge_06" />

        <LinearLayout
            android:id="@+id/card_06"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_06"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="☁️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Deployment &amp; DevOps"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Deploy applications&#10;Environment configuration&#10;CI/CD basics&#10;Monitor applications"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- STEP 07 -->
        <!-- ====================================================== -->

        <TextView
            android:id="@+id/badge_07"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/step_circle"
            android:gravity="center"
            android:text="07"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/card_06"
            app:layout_constraintStart_toStartOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="@id/guide_center" />

        <View
            android:id="@+id/conn_07"
            android:layout_width="16dp"
            android:layout_height="3dp"
            android:layout_marginEnd="-2dp"
            android:background="#6C5CE7"
            app:layout_constraintTop_toTopOf="@id/badge_07"
            app:layout_constraintBottom_toBottomOf="@id/badge_07"
            app:layout_constraintEnd_toStartOf="@id/badge_07" />

        <LinearLayout
            android:id="@+id/card_07"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/badge_07"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_circle"
                    android:backgroundTint="#E4E0FA"
                    android:gravity="center"
                    android:text="🏆"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Industry Backend Project"
                    android:textColor="#161638"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Plan a complete backend system&#10;Develop and test the project&#10;Document your work&#10;Showcase the project on GitHub"
                android:textColor="#3A3A55"
                android:textSize="12.5sp" />

        </LinearLayout>

        <!-- ====================================================== -->
        <!-- FOOTER CARD -->
        <!-- ====================================================== -->

        <LinearLayout
            android:id="@+id/card_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/roadmap_card"
            app:layout_constraintStart_toEndOf="@id/guide_center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_07">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/step_circle"
                android:backgroundTint="#E4E0FA"
                android:gravity="center"
                android:text="📈"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Consistent progress today, bigger opportunities tomorrow."
                android:textColor="#161638"
                android:textStyle="bold"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ===== ALMOST INDUSTRY READY ===== -->

        <TextView
            android:id="@+id/badge_almost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/roadmap_pill"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="ALMOST INDUSTRY READY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.501"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_footer"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
