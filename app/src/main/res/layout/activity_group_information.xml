<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#080B2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Arrow -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Header Title -->

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:text="Group Workspace"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- More -->

        <TextView
            android:id="@+id/moreButton"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Profile -->

        <TextView
            android:id="@+id/profileButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="#E9E7F4"
            android:gravity="center"
            android:text="●"
            android:textColor="#77788A"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SCROLLABLE PAGE -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/groupInformationScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/topHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">


            <!-- ================================================= -->
            <!-- PURPLE ACCENT -->
            <!-- ================================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#C39AFF" />


            <!-- ================================================= -->
            <!-- GROUP INFORMATION CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/groupHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <!-- Group Title -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvGroupIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="#09245D"
                            android:gravity="center"
                            android:text="🚀"
                            android:textSize="19sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvGroupStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#F0EFF3"
                                android:paddingStart="7dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="7dp"
                                android:paddingBottom="3dp"
                                android:text="●  Active Cohort"
                                android:textColor="#77707E"
                                android:textSize="7sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGroupName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Career Launchpad"
                                android:textColor="#15172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMemberCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="196 Eduvos Students"
                                android:textColor="#696A78"
                                android:textSize="8sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- Description -->

                    <TextView
                        android:id="@+id/tvGroupDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Share opportunities, career advice, portfolio tips, LinkedIn guidance and strategies for moving from university into the workplace."
                        android:textColor="#555665"
                        android:textSize="9sp"
                        android:lineSpacingExtra="2dp" />


                    <!-- Moderation -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F0F0F3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="7dp">

                        <TextView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:gravity="center"
                            android:text="✿"
                            android:textColor="#8061C5"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Faculty Moderated &amp; Student-Led"
                            android:textColor="#4F5060"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- WHAT THIS GROUP IS FOR -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/purposeSectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:id="@+id/tvPurposeHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="◉  What this group is for"
                        android:textColor="#15172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <!-- DYNAMIC GROUP PURPOSE -->

                    <TextView
                        android:id="@+id/tvGroupPurpose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F1F1F3"
                        android:padding="10dp"
                        android:textColor="#50515E"
                        android:textSize="8sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- GROUP RULES -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/rulesSectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <!-- Rules Heading -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRulesHeading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="◉  Group Rules"
                            android:textColor="#15172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#F1F1F3"
                            android:paddingStart="6dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="3dp"
                            android:text="10 Standards"
                            android:textColor="#777783"
                            android:textSize="7sp" />

                    </LinearLayout>


                    <!-- Rules Description -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Contribute positively. To keep our community safe and supportive."
                        android:textColor="#777783"
                        android:textSize="8sp" />


                    <!-- DYNAMIC GROUP RULES -->

                    <TextView
                        android:id="@+id/tvGroupRules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F1F1F3"
                        android:padding="10dp"
                        android:textColor="#50515E"
                        android:textSize="8sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- AGREEMENT -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/agreementCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <CheckBox
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:buttonTint="#09245D"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tvAgreement"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="By joining this group, you agree to follow the group rules and use the group for its intended purpose."
                        android:textColor="#555665"
                        android:textSize="8sp"
                        android:lineSpacingExtra="1dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- JOIN GROUP -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnJoinGroup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#09245D"
                android:text="♟  Join Group"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- BACK TO GROUPS -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnBackToGroups"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#F0F0F3"
                android:text="Back to Groups"
                android:textAllCaps="false"
                android:textColor="#44445A"
                android:textSize="9sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>