<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IntelliPath"
                android:textColor="#151C52"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Log Out"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#151C52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="19sp" />

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Feedback &amp; Reports"
            android:textColor="#17172F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage and review student feedback and incident reports."
            android:textColor="#77778A"
            android:textSize="11sp" />


        <!-- FILTERS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Priority: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Status: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Category: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

        </LinearLayout>



        <!-- REPORT 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kgabo Mokoka"
                android:textColor="#55556A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Low Priority • Oct 20, 2026"
                android:textColor="#888899"
                android:textSize="8sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="The learner in the SQL Query Optimization lab was unable to complete the lab due to an issue with the provided test database."
                android:textColor="#55556A"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:layout_width="105dp"
                android:layout_height="45dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="View Details"
                android:textColor="#55556A"
                android:textSize="8sp"
                android:backgroundTint="#EEEEF3" />

        </LinearLayout>


        <!-- BOTTOM NAV -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nDashboard"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navStudents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙\nStudents"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navAssessments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="□\nAssessments"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/navReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▤\nReports"
                android:textColor="#6C5CE7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙\nSettings"
                android:textColor="#77778A"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>