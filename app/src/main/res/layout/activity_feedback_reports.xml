<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IntelliPath"
                android:textColor="#151C52"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="19sp" />

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Feedback &amp; Reports"
            android:textColor="#17172F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage and review student feedback and incident reports."
            android:textColor="#77778A"
            android:textSize="11sp" />


        <!-- FILTERS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Priority: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Status: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Category: All ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

        </LinearLayout>


        <!-- REPORT 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="EK"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#77778A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elena Koshka"
                        android:textColor="#17172F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: STU-98720 • Oct 24, 2023"
                        android:textColor="#888899"
                        android:textSize="8sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="75dp"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:text="● High Priority"
                    android:textColor="#D94A4A"
                    android:textSize="7sp"
                    android:background="#FFE8E8" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Content Error"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Question #14 on the Python assessment has an incorrect answer key. The explanation provided contradicts the code snippet."
                android:textColor="#55556A"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Assign"
                    android:textColor="#6C5CE7"
                    android:textSize="9sp" />

                <Button
                    android:layout_width="105dp"
                    android:layout_height="45dp"
                    android:text="View Details"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:backgroundTint="#151C52" />

            </LinearLayout>

        </LinearLayout>


        <!-- REPORT 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="MJ"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#6C5CE7" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marcus Johnson"
                        android:textColor="#17172F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: STU-91354 • Oct 23, 2023"
                        android:textColor="#888899"
                        android:textSize="8sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="75dp"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:text="● Medium Priority"
                    android:textColor="#B27A20"
                    android:textSize="7sp"
                    android:background="#FFF3DF" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Application Bug"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Application crashes immediately after successful administrator login on Android 14. Login indicates a null pointer exception in the Dashboard initialization."
                android:textColor="#55556A"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:layout_width="105dp"
                    android:layout_height="45dp"
                    android:text="Resolve"
                    android:textColor="#55556A"
                    android:textSize="8sp"
                    android:backgroundTint="#EEEEF3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Assign"
                    android:textColor="#6C5CE7"
                    android:textSize="9sp" />

                <Button
                    android:layout_width="105dp"
                    android:layout_height="45dp"
                    android:text="View Details"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:backgroundTint="#151C52" />

            </LinearLayout>

        </LinearLayout>


        <!-- REPORT 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SL   Sarah Lin"
                android:textColor="#55556A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Low Priority • Oct 20, 2023"
                android:textColor="#888899"
                android:textSize="8sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="The learner in the SQL Query Optimization lab was unable to complete the lab due to an issue with the provided test database."
                android:textColor="#55556A"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:layout_width="105dp"
                android:layout_height="45dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="View Details"
                android:textColor="#55556A"
                android:textSize="8sp"
                android:backgroundTint="#EEEEF3" />

        </LinearLayout>


        <!-- BOTTOM NAV -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂&#10;Dashboard"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙&#10;Students"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="□&#10;Assessments"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▤&#10;Reports"
                android:textColor="#6C5CE7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙&#10;Settings"
                android:textColor="#77778A"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>