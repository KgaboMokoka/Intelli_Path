<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Architect the System"
            android:textColor="#07113D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="You're three weeks into your first job as a Junior Backend Developer. Your team needs to design a new platform for course content, assessment submission, and progress tracking — expected to serve around 3,000 students, with 70% of submissions landing in the final two hours before a deadline.

A senior developer has proposed a monolith. Another developer is pushing back, worried about the submission spike. Your team has four people and one semester to reach MVP.

Walk through five steps to architect the system, then see how your choices hold up."
            android:textColor="#374151"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnStartLab"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:text="Start Simulation"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCancelLab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#6B7280"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>