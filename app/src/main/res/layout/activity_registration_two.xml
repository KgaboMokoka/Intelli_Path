<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_purple_tint"
    android:fillViewport="true"
    tools:context=".RegistrationTwo">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tell us about your academic journey"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="We use this to customize your curriculum and connect you with peers."
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Campus *"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/campusDropdown"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_field"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Current Academic Year *"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/currentAcademicYearDropDown"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_field"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Career Goal *"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Select your primary career aspiration."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Career Goals Grid with Matching Icons -->
            <GridLayout
                android:id="@+id/careerGoalGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:columnCount="2"
                android:rowCount="3">

                <!-- Full Stack Developer: Globe -->
                <TextView
                    android:id="@+id/goalFullStack"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_globe"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Full Stack\nDeveloper"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

                <!-- Front-End Developer: Art Palette -->
                <TextView
                    android:id="@+id/goalFrontEnd"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_palette"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Front-End\nDeveloper"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

                <!-- Back-End Developer: Gear -->
                <TextView
                    android:id="@+id/goalBackEnd"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_gear"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Back-End\nDeveloper"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

                <!-- AI Engineer: Robot -->
                <TextView
                    android:id="@+id/goalAI"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_robot"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="AI\nEngineer"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

                <!-- Data Engineer: Chart -->
                <TextView
                    android:id="@+id/goalData"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_data_engineer"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Data\nEngineer"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

                <!-- Cloud Engineer: Cloud Upload -->
                <TextView
                    android:id="@+id/goalCloud"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tile_goal"
                    android:drawableTop="@drawable/ic_cloud_upload"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Cloud\nEngineer"
                    android:textAlignment="center"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/primary" />

            </GridLayout>

            <Button
                android:id="@+id/registrationContinueButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_primary"
                android:text="Finish Registration"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>