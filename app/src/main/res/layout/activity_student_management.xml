<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IntelliPath"
                android:textColor="#151C52"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="19sp" />

        </LinearLayout>


        <!-- PAGE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Student Directory"
            android:textColor="#17172F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage, filter, and review student profiles and readiness metrics."
            android:textColor="#77778A"
            android:textSize="11sp" />


        <!-- ACTION BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="+ Add Student"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#151C52" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Export"
                android:textColor="#151C52"
                android:textSize="11sp"
                android:backgroundTint="#E9E7F8" />

        </LinearLayout>


        <!-- SEARCH -->

        <EditText
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="14dp"
            android:hint="Search by name, ID or email..."
            android:textSize="11sp"
            android:padding="12dp"
            android:background="#FFFFFF" />


        <!-- FILTERS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Academic Year ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Campus ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Career Goal ▾"
                android:textColor="#55556A"
                android:textSize="9sp"
                android:background="#FFFFFF" />

        </LinearLayout>


        <!-- STUDENT 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="ER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="#6C5CE7" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elena Rodriguez"
                    android:textColor="#17172F"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: STU-98720"
                    android:textColor="#77778A"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="YEAR\n1ST"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOAL\nAI Engineer"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Active"
                    android:textColor="#3B8B57"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="Readiness 92%"
                    android:textColor="#6C5CE7"
                    android:textSize="7sp"
                    android:background="#EEEAFB" />

            </LinearLayout>

        </LinearLayout>


        <!-- STUDENT 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="MC"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="#151C52" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marcus Chen"
                    android:textColor="#17172F"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: STU-91354"
                    android:textColor="#77778A"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="YEAR\n3RD"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOAL\nBackend Developer"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● At Risk"
                    android:textColor="#D9912D"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="Readiness 64%"
                    android:textColor="#D9912D"
                    android:textSize="7sp"
                    android:background="#FFF3DF" />

            </LinearLayout>

        </LinearLayout>


        <!-- STUDENT 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="SJ"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="#8F82E5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sarah Jenkins"
                    android:textColor="#17172F"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: STU-77211"
                    android:textColor="#77778A"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="YEAR\n2ND"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOAL\nProduct Manager"
                    android:textColor="#77778A"
                    android:textSize="8sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Active"
                    android:textColor="#3B8B57"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="Readiness 88%"
                    android:textColor="#6C5CE7"
                    android:textSize="7sp"
                    android:background="#EEEAFB" />

            </LinearLayout>

        </LinearLayout>


        <!-- BOTTOM NAVIGATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nDashboard"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙\nStudents"
                android:textColor="#6C5CE7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="□\nAssessments"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▤\nReports"
                android:textColor="#77778A"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚙\nSettings"
                android:textColor="#77778A"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>