<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F8FC">
    <!--  HEADER  -->
    <LinearLayout android:id="@+id/topHeader" android:layout_width="0dp" android:layout_height="58dp" android:background="#080B2A" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/menuButton" android:layout_width="35dp" android:layout_height="match_parent" android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="21sp"/>
        <TextView android:id="@+id/appName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="IntelliPath" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/profileButton" android:layout_width="38dp" android:layout_height="38dp" android:background="#E9E7F8" android:gravity="center" android:text="👤" android:textSize="17sp"/>
    </LinearLayout>
    <!--  MAIN SCROLL  -->
    <ScrollView android:id="@+id/collaborationScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/topHeader" app:layout_constraintBottom_toTopOf="@id/bottomNavigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvCollaborationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Collaboration" android:textColor="#10142F" android:textSize="25sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCollaborationSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Connect, learn and grow together." android:textColor="#626477" android:textSize="12sp"/>
            <TextView android:id="@+id/tvCollaborationIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Join communities where IntelliPath students can share knowledge, support one another and collaborate on their university-to-work journey." android:textColor="#626477" android:textSize="11sp"/>
            <TextView android:id="@+id/tvGroupsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Collaboration Groups" android:textColor="#151831" android:textSize="16sp" android:textStyle="bold"/>
            <!--  HORIZONTAL GROUPS  -->
            <HorizontalScrollView android:id="@+id/mainGroupsScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/mainGroupsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <!--  WORKPLACE CREW  -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardWorkplaceCrew" android:layout_width="270dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="#EEEAFB" android:padding="10dp" android:src="@android:drawable/ic_menu_myplaces" android:tint="#6744B7" android:contentDescription="Workplace Crew icon"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Workplace Crew" android:textColor="#171A34" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Share interview experiences, workplace advice and practical tips for preparing for the world of work." android:textColor="#737586" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvWorkplaceMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 members" android:textColor="#777A88" android:textSize="9sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Group →" android:textColor="#6744B7" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  DEVELOPER SQUAD  -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardDeveloperSquad" android:layout_width="270dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="#EEEAFB" android:padding="10dp" android:src="@android:drawable/ic_menu_edit" android:tint="#6744B7" android:contentDescription="Developer Squad icon"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Developer Squad" android:textColor="#171A34" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Help each other solve coding problems, discuss development projects and learn new technical skills." android:textColor="#737586" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvDeveloperMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 members" android:textColor="#777A88" android:textSize="9sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Group →" android:textColor="#6744B7" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  CAREER LAUNCHPAD  -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardCareerLaunchpad" android:layout_width="270dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="#EEEAFB" android:padding="10dp" android:src="@android:drawable/ic_menu_compass" android:tint="#6744B7" android:contentDescription="Career Launchpad icon"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Career Launchpad" android:textColor="#171A34" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Share opportunities, career advice, portfolio tips, LinkedIn guidance and networking strategies." android:textColor="#737586" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvCareerMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 members" android:textColor="#777A88" android:textSize="9sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Group →" android:textColor="#6744B7" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!--  PROJECT PARTNERS  -->
                    <androidx.cardview.widget.CardView android:id="@+id/cardProjectPartners" android:layout_width="270dp" android:layout_height="wrap_content" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="#EEEAFB" android:padding="10dp" android:src="@android:drawable/ic_menu_share" android:tint="#6744B7" android:contentDescription="Project Partners icon"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Project Partners" android:textColor="#171A34" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Find students to collaborate with on university projects, assignments and software development tasks." android:textColor="#737586" android:textSize="10sp"/>
                            <TextView android:id="@+id/tvProjectMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 members" android:textColor="#777A88" android:textSize="9sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Group →" android:textColor="#6744B7" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>
            <!--  COMMUNITY GROUPS  -->
            <TextView android:id="@+id/tvCreateGroupTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Community Groups" android:textColor="#151831" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCreateGroupSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Create up to 2 groups of your own." android:textColor="#737586" android:textSize="10sp"/>
            <!--  CREATE GROUP BUTTON  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardCreateGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <TextView android:layout_width="45dp" android:layout_height="45dp" android:background="#EEEAFB" android:gravity="center" android:text="+" android:textColor="#6744B7" android:textSize="26sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create a Group" android:textColor="#171A34" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvCreateGroupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="You can create 2 more groups." android:textColor="#737586" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create →" android:textColor="#6744B7" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!--  YOUR GROUPS  -->
            <TextView android:id="@+id/tvYourGroupsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Groups Created By You" android:textColor="#151831" android:textSize="14sp" android:textStyle="bold" android:visibility="gone"/>
            <LinearLayout android:id="@+id/createdGroupsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <!--  COMMUNITY GUIDELINES  -->
            <androidx.cardview.widget.CardView android:id="@+id/cardCommunityGuidelines" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="#F0EFF8" app:cardCornerRadius="12dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
                    <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="#E3DDF7" android:gravity="center" android:text="✓" android:textColor="#6744B7" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:text="Community Guidelines Be respectful, keep discussions relevant and use IntelliPath to learn, collaborate and support one another." android:textColor="#737586" android:textSize="9sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <!--  BOTTOM NAVIGATION  -->
    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="0dp" android:layout_height="62dp" android:background="#080B2A" android:gravity="center" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/navDashboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textColor="#B8B8C7" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textColor="#B8B8C7" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navAssessments" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣" android:textColor="#B8B8C7" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assessments" android:textColor="#B8B8C7" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navProgress" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌁" android:textColor="#B8B8C7" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress" android:textColor="#B8B8C7" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♙" android:textColor="#B8B8C7" android:textSize="17sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="#B8B8C7" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>