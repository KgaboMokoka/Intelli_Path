<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#080B2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="5dp"
            android:text="Group Workspace"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="21sp"/>

        <TextView
            android:id="@+id/profileButton"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginStart="7dp"
            android:background="#E8E6F3"
            android:gravity="center"
            android:text="●"
            android:textColor="#77788A"
            android:textSize="12sp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/membersScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/topHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- GROUP PROFILE CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/groupProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="9dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Purple accent -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#C39AFF"/>

                    <!-- Rocket -->

                    <TextView
                        android:id="@+id/tvGroupIcon"
                        android:layout_width="39dp"
                        android:layout_height="39dp"
                        android:layout_marginTop="8dp"
                        android:background="#E8D8FF"
                        android:gravity="center"
                        android:text="🚀"
                        android:textSize="17sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="COHORT HUB"
                        android:textColor="#9A7BC2"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvGroupName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Career Launchpad"
                        android:textColor="#15172A"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvGroupDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Share opportunities, career advice, portfolio tips, LinkedIn guidance and strategies for moving from university into the workplace."
                        android:textColor="#656674"
                        android:textSize="8sp"
                        android:lineSpacingExtra="2dp"/>

                    <!-- Members -->

                    <TextView
                        android:id="@+id/tvMemberCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#F0F0F3"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="●  196 Members Enrolled"
                        android:textColor="#777783"
                        android:textSize="7sp"/>

                    <!-- Verified -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="#F0E6FF"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="✓  Verified Cohort"
                        android:textColor="#7650A8"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- GROUP MEMBERS HEADING -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMembersHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Group Members 196"
                    android:textColor="#202136"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≡  Filter"
                    android:textColor="#8061C5"
                    android:textSize="7sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <EditText
                android:id="@+id/etSearchMembers"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="⌕  Search members or tracks..."
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textColor="#333344"
                android:textColorHint="#888894"
                android:textSize="7sp"
                android:singleLine="true"/>


            <!-- ================================================= -->
            <!-- MEMBERS CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/membersCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="9dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:id="@+id/memberListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <!-- MEMBER 1 -->

                    <LinearLayout
                        android:id="@+id/memberBonolo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#B7C5D7"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Bonolo M."
                                android:textColor="#252637"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Year 3 • Full Stack Track"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:text="▢"
                            android:textColor="#777783"
                            android:textSize="13sp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"/>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEF1"/>


                    <!-- MEMBER 2 -->

                    <LinearLayout
                        android:id="@+id/memberThabo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#A9B9B9"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Thabo K."
                                android:textColor="#252637"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Year 3 • Backend Track"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:text="▢"
                            android:textColor="#777783"
                            android:textSize="13sp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"/>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEF1"/>


                    <!-- MEMBER 3 -->

                    <LinearLayout
                        android:id="@+id/memberBoitumelo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#C5C7D0"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Boitumelo S."
                                android:textColor="#252637"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Year 2 • Cloud Track"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:text="▢"
                            android:textColor="#777783"
                            android:textSize="13sp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"/>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEF1"/>


                    <!-- MEMBER 4 -->

                    <LinearLayout
                        android:id="@+id/memberLerato"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#D8D0F0"
                            android:gravity="center"
                            android:text="LN"
                            android:textColor="#7253A2"
                            android:textSize="8sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Lerato N."
                                android:textColor="#252637"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Year 3 • Mobile App Track"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:text="▢"
                            android:textColor="#777783"
                            android:textSize="13sp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"/>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEF1"/>


                    <!-- MEMBER 5 -->

                    <LinearLayout
                        android:id="@+id/memberKabelo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#B9AFA3"
                            android:gravity="center"
                            android:text="K"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Kabelo D."
                                android:textColor="#252637"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Year 3 • Software Engineering"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:text="▢"
                            android:textColor="#777783"
                            android:textSize="13sp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"/>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEF1"/>


                    <!-- CURRENT USER -->

                    <LinearLayout
                        android:id="@+id/memberCurrentUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#F7F2FF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#A99CCB"
                            android:gravity="center"
                            android:text="LM"
                            android:textColor="#FFFFFF"
                            android:textSize="8sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:text="Lebohang M."
                                    android:textColor="#252637"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="  (You)"
                                    android:textColor="#8061C5"
                                    android:textSize="7sp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>

                            <TextView
                                android:text="Year 3 • Student Member"
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E6D8FF"
                            android:paddingStart="5dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="5dp"
                            android:paddingBottom="3dp"
                            android:text="Active Now"
                            android:textColor="#7956A7"
                            android:textSize="6sp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- MEMBER COUNT -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Showing 6 of 196 students"
                    android:textColor="#777783"
                    android:textSize="7sp"/>

                <TextView
                    android:id="@+id/btnViewAllMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all 196 ›"
                    android:textColor="#8061C5"
                    android:textSize="7sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- GUIDELINES & POLICIES -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guidelines &amp; Policies"
                android:textColor="#202136"
                android:textSize="11sp"
                android:textStyle="bold"/>


            <androidx.cardview.widget.CardView
                android:id="@+id/guidelinesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="9dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:id="@+id/btnCommunityGuidelines"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="#F0F0F3"
                        android:gravity="center"
                        android:text="⚖"
                        android:textColor="#555665"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Community Guidelines"
                            android:textColor="#333344"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Review 10 Community Guidelines &amp; Code"
                            android:textColor="#777783"
                            android:textSize="7sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <TextView
                        android:text="⌄"
                        android:textColor="#777783"
                        android:textSize="13sp"
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- LEAVE GROUP CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/leaveGroupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFF2F2"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="#FFD8D8"
                            android:gravity="center"
                            android:text="⇥"
                            android:textColor="#D22A2A"
                            android:textSize="14sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Leave Group"
                                android:textColor="#333344"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Leave this group and stop receiving messages, opportunities, and cohort notifications."
                                android:textColor="#777783"
                                android:textSize="7sp"
                                android:lineSpacingExtra="1dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                    </LinearLayout>


                    <Button
                        android:id="@+id/btnLeaveGroup"
                        android:layout_width="100dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#C62828"
                        android:text="⇥  Leave Group"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>