<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#080B2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back -->

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Title -->

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="5dp"
            android:text="Team Chat"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- More -->

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="21sp"/>

        <!-- Profile -->

        <TextView
            android:id="@+id/chatProfile"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginStart="7dp"
            android:background="#E7E5F1"
            android:gravity="center"
            android:text="●"
            android:textColor="#77788A"
            android:textSize="12sp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- GROUP INFORMATION BAR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/groupChatInfo"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/chatHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Group icon -->

        <TextView
            android:id="@+id/tvGroupChatIcon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:background="#09245D"
            android:gravity="center"
            android:text="CL"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"/>

        <!-- Group details -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Career Launchpad"
                android:textColor="#202136"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvChatMemberCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="196 members • tap for info"
                android:textColor="#777783"
                android:textSize="7sp"/>

        </LinearLayout>

        <!-- Info button -->

        <TextView
            android:id="@+id/btnGroupInfo"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:gravity="center"
            android:text="ⓘ"
            android:textColor="#50515E"
            android:textSize="15sp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CHAT MESSAGES -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/groupChatInfo"
        app:layout_constraintBottom_toTopOf="@id/messageComposer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">


            <!-- ================================================= -->
            <!-- TODAY -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#E8E8EB"
                android:paddingStart="11dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp"
                android:text="Today"
                android:textColor="#777783"
                android:textSize="7sp"
                android:textStyle="bold"/>


            <!-- ================================================= -->
            <!-- THABO MESSAGE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="bottom"
                    android:background="#D4D9E1"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thabo"
                        android:textColor="#202136"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/messageThabo1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#FFFFFF"
                        android:padding="10dp"
                        android:text="Hey, has anyone applied to the Amazon Graduate Program?"
                        android:textColor="#343545"
                        android:textSize="8sp"
                        android:lineSpacingExtra="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="10:14 AM"
                        android:textColor="#85858F"
                        android:textSize="6sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BOITUMELO MESSAGE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="bottom"
                    android:background="#C6D4D6"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boitumelo"
                        android:textColor="#202136"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#FFFFFF"
                        android:padding="10dp"
                        android:text="Yes, I applied last week. They sent me an assessment after applying."
                        android:textColor="#343545"
                        android:textSize="8sp"
                        android:lineSpacingExtra="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="10:18 AM"
                        android:textColor="#85858F"
                        android:textSize="6sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MY MESSAGE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/messageMine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="235dp"
                    android:background="#E8D8FF"
                    android:padding="10dp"
                    android:text="Thanks! What kind of assessment was it?"
                    android:textColor="#4D3274"
                    android:textSize="8sp"
                    android:lineSpacingExtra="1dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="10:21 AM • Delivered ✓✓"
                android:textColor="#7C668F"
                android:textSize="6sp"/>


            <!-- ================================================= -->
            <!-- BOITUMELO MESSAGE 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="bottom"
                    android:background="#C6D4D6"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boitumelo"
                        android:textColor="#202136"
                        android:textSize="7sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#FFFFFF"
                        android:padding="10dp"
                        android:text="It was mostly Java OOP concepts, SQL queries, and a quick cognitive problem-solving section. Around 45 minutes total."
                        android:textColor="#343545"
                        android:textSize="8sp"
                        android:lineSpacingExtra="1dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="3dp"
                        android:background="#F0F0F3"
                        android:padding="5dp"
                        android:text="▣  Java  •  SQL  •  45m timed"
                        android:textColor="#555665"
                        android:textSize="6sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="10:24 AM"
                        android:textColor="#85858F"
                        android:textSize="6sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MY MESSAGE 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/messageMine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="235dp"
                    android:background="#E8D8FF"
                    android:padding="10dp"
                    android:text="Super helpful, preparing my resume and revision notes today!"
                    android:textColor="#4D3274"
                    android:textSize="8sp"
                    android:lineSpacingExtra="1dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="10:26 AM • Sent ✓✓"
                android:textColor="#7C668F"
                android:textSize="6sp"/>


            <!-- ================================================= -->
            <!-- TYPING INDICATOR -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTyping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="13dp"
                android:text="• Thabo is typing..."
                android:textColor="#777783"
                android:textSize="7sp"/>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- MESSAGE COMPOSER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/messageComposer"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Plus -->

        <TextView
            android:id="@+id/btnAttach"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#555665"
            android:textSize="21sp"/>


        <!-- Message input -->

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#F1F1F3"
            android:hint="Type a message..."
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#333344"
            android:textColorHint="#8A8A94"
            android:textSize="8sp"
            android:singleLine="true"/>


        <!-- Extra -->

        <TextView
            android:id="@+id/btnExtra"
            android:layout_width="27dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="‹›"
            android:textColor="#555665"
            android:textSize="13sp"/>


        <!-- Send -->

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="#09245D"
            android:gravity="center"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#080B2A"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dashboard -->

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="6sp"/>

        </LinearLayout>


        <!-- Assessments -->

        <LinearLayout
            android:id="@+id/navAssessments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assessments"
                android:textColor="#FFFFFF"
                android:textSize="6sp"/>

        </LinearLayout>


        <!-- Progress -->

        <LinearLayout
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌁"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textColor="#FFFFFF"
                android:textSize="6sp"/>

        </LinearLayout>


        <!-- Profile -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="6sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>