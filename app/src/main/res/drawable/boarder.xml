<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- The color inside the view (use @android:color/transparent for no fill) -->
    <solid android:color="@android:color/transparent" />

    <!-- The border thickness (width) and color -->
    <stroke
        android:width="2dp"
        android:color="#FF000000" />

    <!-- Optional: Rounded corners (remove if you want sharp corners) -->
    <corners android:radius="8dp" />

    <!-- Optional: Space between the border and the view's content -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</shape>